{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tap",
  "version": "0.2.4",
  "identifier": "app.tap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tap",
        "width": 368,
        "height": 220,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 860, "height": 540 },
        "appPosition": { "x": 215, "y": 312 },
        "applicationFolderPosition": { "x": 560, "y": 312 }
      }
    },
    "shortDescription": "Press-and-hold attention signal for coworkers",
    "longDescription": "Tap lets you press-and-hold a coworker's name to show a click-through screen overlay on their machine while you hold."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tap"]
      }
    },
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MUM3M0Q4QUU5OTJDMUUKUldRZUxKbXUySE1jcElIYnhaMmVXV2l5SHBNdWJWWEhUZXJNTXBDVjZldHllOTlBeU8yWHlmTG4K",
      "endpoints": [
        "https://github.com/rhagerty32/tap/releases/latest/download/latest.json"
      ]
    }
  }
}